# LLM provider: claude_code (local CLI) | gemini | anthropic | replay (keyless, recorded responses)
LLM_PROVIDER=replay
# Write live responses to data/replay/ so they can be replayed later (ignored for replay)
LLM_RECORD=0
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_S=120

CLAUDE_CODE_MODEL=sonnet
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# Optional prompt pins (default: latest version)
PROMPT_VERSION_EXTRACT=
PROMPT_VERSION_COMPILE=

# Storage
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
# Seed demo claims on startup (used on the hosted demo)
SEED_DEMO=0
# Replay mode treats this date as today so the recorded demo never ages (empty = real date)
DEMO_TODAY=2026-10-10
# Pause per replayed LLM call so per-document progress is visible on screen (0 = instant)
REPLAY_DELAY_S=0

# Bearer token for /api/admin/* (unset = open)
ADMIN_TOKEN=

# Demo employee profile: payer / billed-to names are checked against these (policy 2.1, 6.2)
EMPLOYEE_NAME=Kavya Mehta
EMPLOYEE_GRADE=M2
EMPLOYEE_BASE_CITY=Mumbai
COMPANY_NAME=Jio Platforms Limited

# Question planner
TAU=0.75
MAX_QUESTIONS_PER_ROUND=3
